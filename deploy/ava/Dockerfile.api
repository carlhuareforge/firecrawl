# syntax=docker/dockerfile:1
ARG BASE_IMAGE=ghcr.io/firecrawl/firecrawl@sha256:3bc963b8f9ea7a7cd72e967e7fe4fb95e384ee9900bf99becbce32572ff5cda1
FROM ${BASE_IMAGE} AS compile
WORKDIR /app
COPY apps/api/src/lib/map-utils.ts /tmp/map-patch/lib/map-utils.ts
COPY apps/api/src/controllers/v2/map.ts /tmp/map-patch/controllers/v2/map.ts
RUN node -e '\
  const fs = require("node:fs"); \
  const ts = require("typescript"); \
  for (const file of ["lib/map-utils.ts", "controllers/v2/map.ts"]) { \
    const input = "/tmp/map-patch/" + file; \
    const result = ts.transpileModule(fs.readFileSync(input, "utf8"), { \
      fileName: input, reportDiagnostics: true, \
      compilerOptions: { target: ts.ScriptTarget.ES2022, module: ts.ModuleKind.NodeNext, esModuleInterop: true } \
    }); \
    if (result.diagnostics.length) throw new Error(result.diagnostics.map(x => ts.flattenDiagnosticMessageText(x.messageText, "\n")).join("\n")); \
    fs.writeFileSync(input.replace(/\.ts$/, ".js"), result.outputText); \
  }'

FROM ${BASE_IMAGE}
COPY --from=compile /tmp/map-patch/lib/map-utils.js /app/dist/src/lib/map-utils.js
COPY --from=compile /tmp/map-patch/controllers/v2/map.js /app/dist/src/controllers/v2/map.js
ARG GIT_SHA=local
ENV FIRECRAWL_BUILD_SHA=${GIT_SHA}
LABEL org.opencontainers.image.source="https://github.com/carlhuareforge/firecrawl" \
      org.opencontainers.image.revision=${GIT_SHA}
RUN printf '%s\n' "$FIRECRAWL_BUILD_SHA" > /app/BUILD_SHA
